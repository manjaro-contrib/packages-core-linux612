From 7f80492a65579815f58da1b6463233cf61f9fbc8 Mon Sep 17 00:00:00 2001
From: Luke Jones <luke@ljones.dev>
Date: Wed, 16 Apr 2025 19:39:36 +1200
Subject: [PATCH 5/8] add qam_mode sys attr

---
 .../zotac-zone-hid/zotac-zone-hid-config.c    | 32 +++++++++++++++++++
 .../hid/zotac-zone-hid/zotac-zone-hid-core.c  | 24 ++++++++++----
 .../hid/zotac-zone-hid/zotac-zone-hid-input.c |  9 ++++++
 drivers/hid/zotac-zone-hid/zotac-zone.h       |  2 ++
 4 files changed, 61 insertions(+), 6 deletions(-)

diff --git a/drivers/hid/zotac-zone-hid/zotac-zone-hid-config.c b/drivers/hid/zotac-zone-hid/zotac-zone-hid-config.c
index 6ac24be107b9..85ba7493cf5b 100644
--- a/drivers/hid/zotac-zone-hid/zotac-zone-hid-config.c
+++ b/drivers/hid/zotac-zone-hid/zotac-zone-hid-config.c
@@ -1928,8 +1928,40 @@ static ssize_t save_config_store(struct device *dev,
 }
 static DEVICE_ATTR_WO(save_config);
 
+static ssize_t qam_mode_show(struct device *dev, struct device_attribute *attr,
+			     char *buf)
+{
+	struct zotac_device *zotac = dev_get_drvdata(dev);
+
+	if (!zotac || !zotac->gamepad)
+		return -ENODEV;
+
+	return sprintf(buf, "%d\n", zotac->gamepad->qam_mode ? 1 : 0);
+}
+
+static ssize_t qam_mode_store(struct device *dev, struct device_attribute *attr,
+			      const char *buf, size_t count)
+{
+	struct zotac_device *zotac = dev_get_drvdata(dev);
+	bool value;
+	int ret;
+
+	if (!zotac || !zotac->gamepad)
+		return -ENODEV;
+
+	ret = kstrtobool(buf, &value);
+	if (ret)
+		return ret;
+
+	zotac->gamepad->qam_mode = value;
+
+	return count;
+}
+DEVICE_ATTR_RW(qam_mode);
+
 static struct attribute *zotac_root_attrs[] = {
 	&dev_attr_save_config.attr,
+	&dev_attr_qam_mode.attr,
 	&dev_attr_vibration_intensity.attr,
 	&dev_attr_vibration_intensity_index.attr,
 	&dev_attr_mouse_speed.attr,
diff --git a/drivers/hid/zotac-zone-hid/zotac-zone-hid-core.c b/drivers/hid/zotac-zone-hid/zotac-zone-hid-core.c
index 304172e04c39..aea0bb95e35c 100644
--- a/drivers/hid/zotac-zone-hid/zotac-zone-hid-core.c
+++ b/drivers/hid/zotac-zone-hid/zotac-zone-hid-core.c
@@ -105,6 +105,10 @@ static int process_keyboard_report(struct zotac_device *zotac, u8 *data,
 				   int size)
 {
 	u32 pattern;
+	bool qam_mode = true;
+
+	if (zotac->gamepad)
+		qam_mode = zotac->gamepad->qam_mode;
 
 	if (size < 5)
 		return 0;
@@ -116,16 +120,24 @@ static int process_keyboard_report(struct zotac_device *zotac, u8 *data,
 		// TODO: change this output depending on qam_mode attribute
 		switch (data[3]) {
 		case 0x6C:
-			zotac_gamepad_send_button(zotac, (int[]){ BTN_MODE },
-						  1);
+			if (qam_mode)
+				zotac_gamepad_send_button(zotac, (int[]){ BTN_MODE }, 1);
+			else
+				zotac_gamepad_send_button(zotac, (int[]){ KEY_F15 }, 1);
 			break;
 		case 0x6D:
-			zotac_gamepad_send_button(
-				zotac, (int[]){ BTN_MODE, BTN_A }, 2);
+			if (qam_mode)
+				zotac_gamepad_send_button(
+					zotac, (int[]){ BTN_MODE, BTN_A }, 2);
+			else
+				zotac_gamepad_send_button(zotac, (int[]){ KEY_F16 }, 1);
 			break;
 		case 0x07:
-			zotac_gamepad_send_button(
-				zotac, (int[]){ BTN_MODE, BTN_X }, 2);
+			if (qam_mode)
+				zotac_gamepad_send_button(
+					zotac, (int[]){ BTN_MODE, BTN_X }, 2);
+			else
+				zotac_gamepad_send_button(zotac, (int[]){ KEY_F17 }, 1);
 			break;
 		}
 		memset(data, 0, size);
diff --git a/drivers/hid/zotac-zone-hid/zotac-zone-hid-input.c b/drivers/hid/zotac-zone-hid/zotac-zone-hid-input.c
index 85afd5dea9e6..41e537db4654 100644
--- a/drivers/hid/zotac-zone-hid/zotac-zone-hid-input.c
+++ b/drivers/hid/zotac-zone-hid/zotac-zone-hid-input.c
@@ -302,6 +302,7 @@ int zotac_init_gamepad(struct zotac_device *zotac, struct usb_interface *intf)
 		goto err_free_gamepad;
 	}
 
+	gamepad->qam_mode = true;
 	gamepad->ep_in = ep_in;
 	gamepad->ep_out = ep_out;
 
@@ -335,6 +336,14 @@ int zotac_init_gamepad(struct zotac_device *zotac, struct usb_interface *intf)
 	input_set_capability(input_dev, EV_KEY, BTN_THUMBL);
 	input_set_capability(input_dev, EV_KEY, BTN_THUMBR);
 
+	/* Allow the gamepad to emit these events for screenface buttons */
+	input_set_capability(input_dev, EV_KEY, KEY_F15);
+	input_set_capability(input_dev, EV_KEY, KEY_F16);
+	input_set_capability(input_dev, EV_KEY, KEY_F17);
+	input_set_capability(input_dev, EV_KEY, KEY_F18);
+	input_set_capability(input_dev, EV_KEY, KEY_F19);
+	input_set_capability(input_dev, EV_KEY, KEY_F20);
+
 	pipe = usb_rcvintpipe(udev, gamepad->ep_in->bEndpointAddress);
 	if (!(maxp = usb_maxpacket(udev, pipe))) {
 		ret = -EINVAL;
diff --git a/drivers/hid/zotac-zone-hid/zotac-zone.h b/drivers/hid/zotac-zone-hid/zotac-zone.h
index 77c9d5594fcf..a657b8c1515c 100644
--- a/drivers/hid/zotac-zone-hid/zotac-zone.h
+++ b/drivers/hid/zotac-zone-hid/zotac-zone.h
@@ -89,6 +89,8 @@ struct zotac_gamepad {
 	unsigned int button_to_press;
 	unsigned int button_to_press2;
 	bool update_qam;
+	/* True if Steam chords should be enabled */
+	bool qam_mode;
 };
 
 struct zotac_rgb_dev {
-- 
